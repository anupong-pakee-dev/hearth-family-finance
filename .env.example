# Copy to .env (or run: node deploy/setup.mjs). Never commit real secrets.
NODE_ENV=production
HEARTH_BASE_URL=https://finance.example.com
# postgres://user:pass@host:5432/db — leave empty for the embedded PGlite dev database
DATABASE_URL=
# Master keys for envelope encryption: "id:<32 random bytes base64>[,oldId:<key>]" — or HEARTH_MASTER_KEYS_FILE
HEARTH_MASTER_KEYS=
HEARTH_TRUST_PROXY=true
HEARTH_SESSION_IDLE_MINUTES=30
HEARTH_SESSION_MAX_DAYS=7
HEARTH_BACKUP_INTERVAL_HOURS=24
# Opt-in online breached-password check (k-anonymity, sends 5 hash chars to api.pwnedpasswords.com)
HEARTH_HIBP_ONLINE=false
LOG_LEVEL=info
